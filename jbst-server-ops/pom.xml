<?xml version="1.0" encoding="UTF-8"?>
<!--suppress VulnerableLibrariesLocal -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>jbst</groupId>
        <artifactId>jbst</artifactId>
        <version>1.22</version>
    </parent>

    <artifactId>jbst-server-ops</artifactId>

    <properties>
        <!-- dependencies -->
        <version.dependency.httpclient>5.4.1</version.dependency.httpclient>
        <version.dependency.slack.api>1.45.2</version.dependency.slack.api>
        <version.dependency.javax.websocket>1.1</version.dependency.javax.websocket>
        <version.dependency.tyrus.standalone.client>1.20</version.dependency.tyrus.standalone.client>
    </properties>

    <dependencies>
        <!-- jbst -->
        <dependency>
            <groupId>jbst</groupId>
            <artifactId>jbst-foundation</artifactId>
            <version>${project.version}</version>
            <scope>compile</scope>
        </dependency>
        <!-- Slack API -->
        <dependency>
            <groupId>com.slack.api</groupId>
            <artifactId>bolt-socket-mode</artifactId>
            <version>${version.dependency.slack.api}</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.tyrus.bundles</groupId>
            <artifactId>tyrus-standalone-client</artifactId>
            <version>${version.dependency.tyrus.standalone.client}</version>
        </dependency>
        <dependency>
            <groupId>javax.websocket</groupId>
            <artifactId>javax.websocket-api</artifactId>
            <version>${version.dependency.javax.websocket}</version>
        </dependency>
        <!-- SSL issue (matches version in spring-boot-dependencies) -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
            <version>${version.dependency.httpclient}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>app</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <!-- Spring Boot -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${version.dependency.springframework.boot}</version>
            </plugin>
            <!-- maven <version></version> => `/actuator/info` endpoint -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>${version.plugin.resource}</version>
            </plugin>
            <!-- git => `actuator/info` endpoint -->
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <version>${version.plugin.git.commit}</version>
            </plugin>
        </plugins>
    </build>
</project>
