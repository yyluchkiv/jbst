# Mutable deployment values for the CI workflows — main.yml loads this file into GITHUB_ENV.
# Kept OUTSIDE the workflow files on purpose: next-release.sh/next-snapshot.sh rewrite these
# values on every release, and the Actions GITHUB_TOKEN is never allowed to push commits that
# modify .github/workflows/* ("refusing to allow a GitHub App to create or update workflow"),
# which broke release.yml when the flags lived in main.yml.
MAVEN_DEPLOYMENT_ENABLED=false
DOCKER_VERSION=1.74-SNAPSHOT
DOCKER_PUSH_ENABLED=false
